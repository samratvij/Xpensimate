<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except Tailscale MagicDNS names (*.ts.net): traffic inside a tailnet is already
     encrypted end to end by WireGuard, so the server can be reached over plain HTTP there. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
