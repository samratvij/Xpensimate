# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_USER=expense
POSTGRES_PASSWORD=change-me
POSTGRES_DB=expense

# Bearer token the Android app sends as "Authorization: Bearer <token>", and whose it is
API_TOKEN=change-me
API_TOKEN_USER=Alex
# More people, each with their own token (edits record who made them): Name:token,Name:token
USER_TOKENS=

# Home server with Tailscale: this host's Tailscale IP (tailscale ip -4), so the API port binds only there.
# VPS (compose.vps.yml): leave 127.0.0.1; Caddy serves the API on DOMAIN instead.
API_BIND_HOST=127.0.0.1
# VPS only: the domain Caddy gets an HTTPS certificate for (its DNS must point at this server).
DOMAIN=

TIMEZONE=America/Toronto

# The AI model for the categorization fallback + reading receipt photos. Leave both empty to go without.
# Claude: set the API key.
ANTHROPIC_API_KEY=
# Or a model on your own server (docs/local-models.md): any OpenAI-compatible API, e.g. Ollama.
# compose.ollama.yml sets these two for you.
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=
# Models: a small one for categorizing, one that reads images for receipts. Empty uses the defaults:
# claude-haiku-5-5 / claude-sonnet-5-5 for Claude, qwen2.5vl:7b for both with a local server.
CATEGORIZER_MODEL=
RECEIPT_MODEL=
# Reads screenshots of a bank app's transaction list (default: the categorizer's small model, or the local one).
SCREENSHOT_MODEL=

# Gmail ingestion (docs/gmail-setup.md)
GCP_PROJECT_ID=
PUBSUB_TOPIC=gmail-bank-alerts
PUBSUB_SUBSCRIPTION=bank-alerts-pull
