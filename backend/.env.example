# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_USER=expense
POSTGRES_PASSWORD=change-me
POSTGRES_DB=expense

# Bearer token the Android app sends as "Authorization: Bearer <token>", and whose it is
API_TOKEN=change-me
API_TOKEN_USER=Alex
# More people, each with their own token (edits record who made them): Name:token,Name:token
USER_TOKENS=

# Home server with Tailscale: this host's Tailscale IP (tailscale ip -4), so the API port binds only there.
# VPS (compose.vps.yml): leave 127.0.0.1; Caddy serves the API on DOMAIN instead.
API_BIND_HOST=127.0.0.1
# VPS only: the domain Caddy gets an HTTPS certificate for (its DNS must point at this server).
DOMAIN=

TIMEZONE=America/Toronto

# Claude API key for categorization fallback + receipt OCR. Leave empty to disable LLM calls.
ANTHROPIC_API_KEY=
# Models (defaults shown): a small one for categorizing, a stronger one for reading receipt photos.
CATEGORIZER_MODEL=claude-haiku-5-5
RECEIPT_MODEL=claude-sonnet-5-5

# Gmail ingestion (docs/gmail-setup.md)
GCP_PROJECT_ID=
PUBSUB_TOPIC=gmail-bank-alerts
PUBSUB_SUBSCRIPTION=bank-alerts-pull
